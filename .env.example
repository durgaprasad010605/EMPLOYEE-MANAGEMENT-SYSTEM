# =====================================================================
# EMPLOYEE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to '.env' (or set corresponding environment variables).
# DO NOT commit real secrets or production credentials to version control.
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND CONFIGURATION (Spring Boot)
# ---------------------------------------------------------------------
# Port where Spring Boot will listen (Default: 8080)
SERVER_PORT=8080

# MySQL Database Connection URL
# Database Name: employee_tracker
DB_URL=jdbc:mysql://localhost:3306/employee_tracker?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Database Username (Required in production)
DB_USERNAME=root

# MySQL Database Password (Required)
DB_PASSWORD=your_database_password_here

# JWT Signing Secret (Must be a secure 256-bit hexadecimal or Base64 string in production)
# Example 256-bit Hex Key (64 characters)
JWT_SECRET=your_secure_256_bit_hex_jwt_secret_key_here

# JWT Token Expiration in Milliseconds (Default: 86400000 = 24 Hours)
JWT_EXPIRATION_MS=86400000

# ---------------------------------------------------------------------
# FRONTEND CONFIGURATION (React + Vite)
# ---------------------------------------------------------------------
# Base URL for Spring Boot REST API
# (Note: Vite dev server also proxies '/api' to 'http://localhost:8080')
VITE_API_BASE_URL=http://localhost:8080/api
